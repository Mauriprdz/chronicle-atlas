# Postgres connection string (Neon / Supabase / Vercel Postgres). Leave empty locally to use the embedded DB.
DATABASE_URL=
# Long random string (32+ chars) used to sign JWTs
JWT_SECRET=
# Optional: real email delivery for password recovery (https://resend.com)
RESEND_API_KEY=
MAIL_FROM=Chronicle Atlas <onboarding@resend.dev>
# Optional: Sentry error monitoring (extra points)
SENTRY_DSN=
# Passwords for the 3 demo accounts (set these in Netlify BEFORE the first deploy with a database)
ADMIN_EMAIL=
ADMIN_PASSWORD=
INVESTIGATOR_PASSWORD=
USER_PASSWORD=
